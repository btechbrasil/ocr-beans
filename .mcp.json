{
  "mcpServers": {
    "ocr-beans": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python", "3.12",
        "--with", "pymupdf==1.28.2",
        "--with", "pytesseract==0.3.13",
        "--with", "Pillow==12.3.0",
        "--with", "mcp==2.3.0",
        "python3",
        "${CLAUDE_PLUGIN_ROOT}/ocr_beans/mcp_server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "timeoutMs": 600000
    }
  }
}
